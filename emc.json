{
    "matching": "input[type=\"file\"]",
    "enhConfig": {
        "enhKey": "beLiterate",
        "spawn": "be-literate/be-literate.js",
        "withAttrs": {
            "base": "be-literate",
            "_base": {
                "instanceOf": "Object",
                "mapsTo": "."
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "hydrate": {
                "ifKeyIn": [
                    "readVerb",
                    "initialized"
                ],
                "ifAllOf": [
                    "enhancedElement",
                    "initialized"
                ]
            },
            "storeFileContents": {
                "ifAllOf": [
                    "fileContents",
                    "writeTo"
                ]
            }
        },
        "defaultPropVals": {
            "readVerb": "readAsText"
        }
    }
}
