{
  "name": "be-literate",
  "version": "0.0.14",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "decorate",
    "behavior",
    "directive",
    "read-file",
    "file-reader"
  ],
  "description": "Enhance the input element so it can declaratively read contents from a local file (or files).",
  "main": "be-literate.js",
  "module": "be-literate.js",
  "exports": {
    ".": "./be-literate.js",
    "./be-literate.js": "./be-literate.js",
    "./FileManager.js": "./FileManager.js",
    "./def.js": "./def.js",
    "./emc.json": "./emc.json",
    "./📖.json": "./📖.json"
  },
  "files": [
    "*.js",
    "*.json",
    "types/be-literate/types.d.ts"
  ],
  "types": "types/be-literate/types.d.ts",
  "scripts": {
    "build": "node emc.mjs > emc.json && node 📖.mjs > 📖.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "assign-gingerly": "0.0.109",
    "be-hive": "0.1.18",
    "fifteenth": "0.0.8",
    "mount-observer": "0.1.53",
    "roundabout-lib": "0.0.38"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "spa-ssi": "0.0.31"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-literate.git"
  },
  "author": "Bruce Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-literate/issues"
  },
  "homepage": "https://github.com/bahrus/be-literate#readme"
}
